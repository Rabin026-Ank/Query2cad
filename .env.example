# Copy to .env and fill in. Never commit the real .env.

# --- FreeCAD ---------------------------------------------------------------
FREECAD_CMD=D:\FreeCAD\bin\freecadcmd.exe
FREECAD_TIMEOUT=300

# --- OpenAI-compatible server (text + vision) ------------------------------
ORNITH_BASE_URL=
ORNITH_API_KEY=

# --- Google AI Studio (text + vision) --------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Original backends from the paper (optional) ---------------------------
# TOGETHER_API_KEY=      # codellama, llama3
# PROXY_API_KEY=         # chatgpt, gpt4-turbo
# PROXY_BASE_URL=

# --- Default models (override on the command line any time) ----------------
CODE_MODEL=ornith
REASONING_MODEL=ornith
VISION_MODEL=ornith

# Set to 0 to turn Gemini thinking off for faster, cheaper calls.
# GEMINI_THINKING_BUDGET=0
