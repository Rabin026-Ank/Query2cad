# Copy to .env and fill in. Never commit the real .env.

# --- FreeCAD ---------------------------------------------------------------
FREECAD_CMD=D:\FreeCAD\bin\freecadcmd.exe

# --- Google AI Studio (text + vision) --------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional OpenAI-compatible server (text only, no images) --------------
ORNITH_BASE_URL=
ORNITH_API_KEY=

# --- Default models (override on the command line any time) ----------------
CODE_MODEL=gemini-2.5-flash
REASONING_MODEL=gemini-2.5-flash
VISION_MODEL=gemini-2.5-flash

# Set to 0 to turn Gemini thinking off for faster, cheaper calls.
# GEMINI_THINKING_BUDGET=0
